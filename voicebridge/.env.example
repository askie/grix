# LiveKit Server（docker-compose --dev 模式固定值）
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 语音大模型的 provider/model/endpoint/api_key/voice 由 start 消息下发（BYOK），
# 不再使用 OPENAI_API_KEY / OPENAI_REALTIME_MODEL 环境变量。

# NATS（与 docker-compose 一致）
NATS_URL=nats://localhost:4222
