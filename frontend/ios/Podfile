# Apple requires MinimumOSVersion >= 15.0 for App Store uploads (Spring 2027).
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod 'GoogleSignIn'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      definitions = Array(config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'])
      definitions << '$(inherited)' unless definitions.include?('$(inherited)')
      definitions << 'PERMISSION_CAMERA=1' unless definitions.include?('PERMISSION_CAMERA=1')
      definitions << 'PERMISSION_MICROPHONE=1' unless definitions.include?('PERMISSION_MICROPHONE=1')
      definitions << 'PERMISSION_PHOTOS=1' unless definitions.include?('PERMISSION_PHOTOS=1')
      definitions << 'PERMISSION_PHOTOS_ADD_ONLY=1' unless definitions.include?('PERMISSION_PHOTOS_ADD_ONLY=1')
      definitions << 'PERMISSION_NOTIFICATIONS=1' unless definitions.include?('PERMISSION_NOTIFICATIONS=1')
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions

      # ccache for C/ObjC/C++ pod compilation (speeds up repeat builds).
      # Only applied when ccache is installed; safe no-op otherwise.
      # NOTE: Xcode CC/CXX build settings must be a single executable path —
      # "ccache clang" (with args) fails with "unable to spawn process" on Xcode 26.
      # Use wrapper scripts instead (2026-08-09).
      ccache_bin = `/usr/bin/which ccache`.strip
      unless ccache_bin.empty?
        wrapper_dir = File.join(Dir.home, '.local', 'bin')
        cc_wrapper = File.join(wrapper_dir, 'ccache-clang')
        cxx_wrapper = File.join(wrapper_dir, 'ccache-clang++')
        config.build_settings['CC'] = cc_wrapper unless config.build_settings['CC'].to_s.include?('ccache')
        config.build_settings['CXX'] = cxx_wrapper unless config.build_settings['CXX'].to_s.include?('ccache')
      end
    end
  end
end
