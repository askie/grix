# 阶段 0-1 生产环境配置模板
# 复制为 .env.prod 并填入真实值

# ===== 数据库 =====
POSTGRES_USER=aibot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aibot
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ===== 应用配置 =====
AIBOT_POSTGRES_HOST=postgres
AIBOT_POSTGRES_PORT=5432
AIBOT_POSTGRES_USER=aibot
AIBOT_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AIBOT_POSTGRES_DBNAME=aibot
AIBOT_REDIS_ADDR=redis:6379
AIBOT_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
AIBOT_NATS_URL=nats://nats:4222
AIBOT_JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
AIBOT_CONFIG_PATH=/app/config/config.yaml
AIBOT_SKIP_SCHEMA_INIT=1

# ===== 对象存储 (S3) =====
AIBOT_OSS_MEDIA_ENDPOINT=s3.ap-southeast-1.amazonaws.com
AIBOT_OSS_MEDIA_ACCESS_KEY=
AIBOT_OSS_MEDIA_SECRET_KEY=
AIBOT_OSS_MEDIA_BUCKET=grix-prod-media
AIBOT_OSS_MEDIA_REGION=ap-southeast-1
AIBOT_OSS_MEDIA_USE_SSL=true
AIBOT_OSS_MEDIA_PUBLIC_URL=
AIBOT_OSS_MEDIA_STORAGE_DIR=aibot/media

AIBOT_OSS_AVATAR_ENDPOINT=s3.ap-southeast-1.amazonaws.com
AIBOT_OSS_AVATAR_ACCESS_KEY=
AIBOT_OSS_AVATAR_SECRET_KEY=
AIBOT_OSS_AVATAR_BUCKET=grix-prod-avatar
AIBOT_OSS_AVATAR_REGION=ap-southeast-1
AIBOT_OSS_AVATAR_USE_SSL=true
AIBOT_OSS_AVATAR_PUBLIC_URL=
AIBOT_OSS_AVATAR_STORAGE_DIR=aibot/avatar

# ===== 域名 =====
AIBOT_SERVER_ALLOWED_WEB_ORIGINS=https://grix.dhf.pub
AIBOT_SERVER_AGENT_API_DOMAIN=wss://grix.dhf.pub
AIBOT_SERVER_AGENT_API_PATH=/v1/agent-api
AIBOT_SERVER_AGENT_API_WS_PATH=/ws

# ===== LLM (可选) =====
AIBOT_LLM_OPENAI_API_KEY=
AIBOT_LLM_OPENAI_BASE_URL=
AIBOT_LLM_EMBEDDING_MODEL=embedding-3

# ===== 推送 (可选) =====
AIBOT_PUSH_APNS_KEY_PATH=/var/run/aibot/push/apns/AuthKey.p8
AIBOT_PUSH_APNS_KEY_ID=
AIBOT_PUSH_APNS_TEAM_ID=
AIBOT_PUSH_APNS_TOPIC=
AIBOT_PUSH_FCM_CREDENTIALS_FILE=/var/run/aibot/push/fcm/service-account.json
