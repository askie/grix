AIBOT_SERVER_API_PORT=27180
AIBOT_SERVER_WS_PORT=27189
AIBOT_SERVER_LLM_PORT=27182
AIBOT_SERVER_PUSH_PORT=27183
AIBOT_SERVER_WIDGET_ENABLED=false
AIBOT_SERVER_NODE_ID=ws-node-1
AIBOT_SERVER_ALLOWED_WEB_ORIGINS=https://admin.example.com
AIBOT_SERVER_FRIEND_QR_BASE_URL=https://dhf.pub/u
AIBOT_SERVER_GROUP_QR_BASE_URL=https://dhf.pub/g
AIBOT_SERVER_DEEP_LINK_IOS_APP_ID=TEAMID.pub.dhf.grix
AIBOT_SERVER_DEEP_LINK_ANDROID_PACKAGE=pub.dhf.grix
AIBOT_SERVER_DEEP_LINK_ANDROID_SHA256_CERTS=00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF
AIBOT_SERVER_AGENT_API_DOMAIN=wss://api.example.com
AIBOT_SERVER_AGENT_API_PATH=/v1/agent-api
AIBOT_SERVER_AGENT_API_WS_PATH=/ws
AIBOT_SERVER_AGENT_API_HEARTBEAT_SEC=30
AIBOT_SERVER_WEBHOOK_TOKEN_SECRET=replace_with_dedicated_webhook_secret
AIBOT_SERVER_VOICE_CRYPTO_SECRET=replace_with_dedicated_voice_crypto_secret
AIBOT_SERVER_PAY_CRYPTO_SECRET=replace_with_dedicated_pay_crypto_secret     # 支付通道商户凭证加密密钥，塘主后台录入的 alipay/paypal 密钥落库前用它加密
AIBOT_PAY_INTERNAL_TOKEN=replace_with_shared_service_token                  # api→pay 管理面服务间共享密钥（X-Pay-Internal-Token），api 与 pay 必须一致；非 mock 模式 pay 启动强制非空
AIBOT_SERVER_REGION=global                          # 部署区域：cn 或 global
AIBOT_SERVER_PUBLIC_WS_URL=wss://ws.example.com/ws  # 返回给客户端的 WS 公网地址

# 安全开关：是否允许 local 类型 agent 的 endpoint 指向 loopback/私网。
# 仅自托管（服务端与你自己的模型服务同机/同内网）时置 true；SaaS 必须保持 false。
AIBOT_SECURITY_ALLOW_PRIVATE_LOCAL_ENDPOINT=false
# 媒体对象大小上限（字节），签名下发前服务端复核；默认 104857600（100MB）
AIBOT_SECURITY_MEDIA_MAX_UPLOAD_BYTES=104857600

AIBOT_POSTGRES_HOST=127.0.0.1
AIBOT_POSTGRES_USER=aibot
AIBOT_POSTGRES_PASSWORD=replace_with_real_password
AIBOT_POSTGRES_DBNAME=aibot
AIBOT_POSTGRES_SSLMODE=disable  # 生产走 PgBouncer 集群内不需 TLS; 直连 PG 时改为 require

AIBOT_REDIS_ADDR=127.0.0.1:6380
AIBOT_REDIS_PASSWORD=
AIBOT_NATS_URL=nats://127.0.0.1:4222

AIBOT_JWT_SECRET=replace_with_long_random_secret
AIBOT_SNOWFLAKE_MACHINE_ID=1

# 大模型计费网关：中转开关服务端化 feature flag（默认 true；回滚时置 false，
# POST /v1/gateway/agents/:id/relay 返回 503、GET /agents 回落旧语义）
AIBOT_GATEWAY_RELAY_STATE_ENABLED=true

# 对象存储（S3 协议）：三组用途各自独立配置；endpoint 示例——
#   中国区腾讯 COS: cos.ap-shanghai.myqcloud.com（region: ap-shanghai）
#   全球区 AWS S3:  s3.us-east-1.amazonaws.com（region: us-east-1）
# 本地联调可用 MinIO: 127.0.0.1:9000（此时 region 留空，客户端自动走 path-style）
AIBOT_OSS_MEDIA_ENDPOINT=
AIBOT_OSS_MEDIA_ACCESS_KEY=
AIBOT_OSS_MEDIA_SECRET_KEY=
AIBOT_OSS_MEDIA_BUCKET=
AIBOT_OSS_MEDIA_REGION=
AIBOT_OSS_MEDIA_PUBLIC_URL=
AIBOT_OSS_MEDIA_STORAGE_DIR=aibot/media

AIBOT_OSS_AVATAR_ENDPOINT=
AIBOT_OSS_AVATAR_ACCESS_KEY=
AIBOT_OSS_AVATAR_SECRET_KEY=
AIBOT_OSS_AVATAR_BUCKET=
AIBOT_OSS_AVATAR_REGION=
AIBOT_OSS_AVATAR_PUBLIC_URL=
AIBOT_OSS_AVATAR_STORAGE_DIR=aibot/avatar

AIBOT_OSS_REPORT_ENDPOINT=
AIBOT_OSS_REPORT_ACCESS_KEY=
AIBOT_OSS_REPORT_SECRET_KEY=
AIBOT_OSS_REPORT_BUCKET=
AIBOT_OSS_REPORT_REGION=
AIBOT_OSS_REPORT_PUBLIC_URL=
AIBOT_OSS_REPORT_STORAGE_DIR=aibot/report

# 一次性数据迁移专用（旧共享桶 → 现桶），仅 cmd/migrate 读取；无历史数据可留空
AIBOT_MIGRATION_LEGACY_OSS_ENDPOINT=
AIBOT_MIGRATION_LEGACY_OSS_ACCESS_KEY=
AIBOT_MIGRATION_LEGACY_OSS_SECRET_KEY=
AIBOT_MIGRATION_LEGACY_OSS_BUCKET=
AIBOT_MIGRATION_LEGACY_OSS_REGION=
AIBOT_MIGRATION_LEGACY_OSS_PUBLIC_URL=
AIBOT_MIGRATION_LEGACY_OSS_STORAGE_DIR=aibot

AIBOT_OPENAI_API_KEY=
AIBOT_OPENAI_BASE_URL=
AIBOT_OPENAI_DEFAULT_MODEL=
AIBOT_CLAUDE_API_KEY=
AIBOT_CLAUDE_BASE_URL=
AIBOT_CLAUDE_DEFAULT_MODEL=
AIBOT_LLM_EMBEDDING_MODEL=embedding-3

AIBOT_OAUTH_GOOGLE_ALLOWED_CLIENT_IDS=
AIBOT_OAUTH_APPLE_BUNDLE_IDS=

AIBOT_PUSH_APNS_KEY_PATH=
AIBOT_PUSH_APNS_KEY_ID=
AIBOT_PUSH_APNS_TEAM_ID=
AIBOT_PUSH_APNS_TOPIC=
AIBOT_PUSH_FCM_CREDENTIALS_FILE=
AIBOT_PUSH_JPUSH_APP_KEY=
AIBOT_PUSH_JPUSH_MASTER_SECRET=
AIBOT_PUSH_WEBPUSH_VAPID_PUBLIC_KEY=
AIBOT_PUSH_WEBPUSH_VAPID_PRIVATE_KEY=
AIBOT_PUSH_WEBPUSH_SUBSCRIBER=

# 国产厂商推送通道（仅国内区需要配置；留空即该通道不启用）
AIBOT_PUSH_HUAWEI_APP_ID=
AIBOT_PUSH_HUAWEI_CLIENT_ID=
AIBOT_PUSH_HUAWEI_CLIENT_SECRET=
AIBOT_PUSH_XIAOMI_APP_SECRET=
AIBOT_PUSH_XIAOMI_PACKAGE_NAME=

AIBOT_ALI_EMAIL_ACCESS_KEY_ID=
AIBOT_ALI_EMAIL_ACCESS_KEY_SECRET=
AIBOT_ALI_EMAIL_REGION_ID=cn-hangzhou
AIBOT_ALI_EMAIL_ENDPOINT=dm.aliyuncs.com
AIBOT_ALI_EMAIL_FROM_ADDRESS=no-reply@example.com

# Phase 1: LiveKit（语音通话媒体服务器，三项须同时配置或同时留空）
AIBOT_LIVEKIT_URL=
AIBOT_LIVEKIT_PUBLIC_URL=
AIBOT_LIVEKIT_API_KEY=
AIBOT_LIVEKIT_API_SECRET=

# LiveKit TURN relay（NAT 穿透，config.yaml 默认已启用）
AIBOT_LIVEKIT_TURN_ENABLED=true
AIBOT_LIVEKIT_TURN_USERNAME=
AIBOT_LIVEKIT_TURN_CREDENTIAL=
# 多个 URL 用逗号分隔（默认 turn:grix.dhf.pub:3478）
# AIBOT_LIVEKIT_TURN_URLS=

# 语音大模型（provider_type=4）为 BYOK：provider/model/endpoint/api_key 由用户在 agent 上自配，
# 服务端不再持有全局语音模型凭证（无全局兜底）。
