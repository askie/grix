# Pick exactly one of the following address sets.
#
# 1. Real iPhone / Android device on the same LAN as this Mac
# API_BASE_URL=http://192.168.0.106:27180/v1
# WS_URL=ws://192.168.0.106:27189/ws
#
# 2. Android Emulator
# API_BASE_URL=http://10.0.2.2:27180/v1
# WS_URL=ws://10.0.2.2:27189/ws
#
# 3. iOS Simulator
API_BASE_URL=http://localhost:27180/v1
WS_URL=ws://localhost:27189/ws

# The values below are intentionally empty.
# Real-device push debugging requires real credentials from the same APNs/Firebase/JPush projects.
# Placeholder strings or mixed-project values will fail device binding or provider delivery.

# Android FCM client bootstrap
AIBOT_ANDROID_FIREBASE_API_KEY=
AIBOT_ANDROID_FIREBASE_APP_ID=
AIBOT_ANDROID_FIREBASE_PROJECT_ID=
AIBOT_ANDROID_FIREBASE_SENDER_ID=

# Android JPush client bootstrap (required for Android packaging)
AIBOT_PUSH_JPUSH_APP_KEY=

# Android Huawei Push Kit client bootstrap (required for Android packaging).
# The Android APK is a single dual-region build, so this is always required —
# release preflight fails without it. Only the App ID ships in the client
# (a public identifier); the Client Secret stays server-side.
AIBOT_ANDROID_HUAWEI_APP_ID=

# Backend push service
AIBOT_PUSH_APNS_KEY_PATH=
AIBOT_PUSH_APNS_KEY_ID=
AIBOT_PUSH_APNS_TEAM_ID=
AIBOT_PUSH_APNS_TOPIC=
AIBOT_PUSH_APNS_IS_PRODUCTION=false
AIBOT_PUSH_FCM_CREDENTIALS_FILE=
AIBOT_PUSH_JPUSH_MASTER_SECRET=
AIBOT_PUSH_WEBPUSH_VAPID_PUBLIC_KEY=
AIBOT_PUSH_WEBPUSH_VAPID_PRIVATE_KEY=
AIBOT_PUSH_WEBPUSH_SUBSCRIBER=

# Web build-time public key (must match backend AIBOT_PUSH_WEBPUSH_VAPID_PUBLIC_KEY)
WEB_PUSH_VAPID_PUBLIC_KEY=
