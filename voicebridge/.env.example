# LiveKit Server（docker-compose --dev 模式固定值）
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 语音大模型的 provider/model/endpoint/api_key/voice 由 start 消息下发（BYOK），
# 不再使用 OPENAI_API_KEY / OPENAI_REALTIME_MODEL 环境变量。

# NATS（与 docker-compose 一致）
NATS_URL=nats://localhost:4222
# 服务端启用账号鉴权后必填（生产经 k8s Secret 注入，见 k8s/infra/base/nats/README.md）
NATS_USER=voicebridge
NATS_PASSWORD=

# 敏感内容日志开关：=1 时通话转写原文 / start_session 完整参数降级 DEBUG 输出，
# 默认关闭（INFO 只记长度）。仅在排障时临时开启。
VOICEBRIDGE_LOG_SENSITIVE=0
